    "test:pencil": "node tools/pencil-test.mjs",
    "test:counter": "node tools/counter-test.mjs",
    "test:scenarios": "node tools/scenarios.js",
    "test:r3-crossing": "node tests/r3-crossing.test.mjs",
    "test:r4-pond": "node tests/r4-pond.test.mjs",
    "test:hole-two-balls": "node tests/hole-two-balls.test.mjs",
    "balance": "node tools/balance.mjs",
    "ceiling": "node tools/ceiling.mjs",
    "probe": "node tools/generator-probe.mjs",
    "golden": "node tools/golden-test.mjs",
    "golden:remint": "node tools/write-golden.mjs --check"
  },
